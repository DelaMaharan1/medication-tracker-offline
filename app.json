{
  "expo": {
    "name": "MediTrack",
    "slug": "MediTrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "assets/icons/icons-light.png",
    "scheme": "medicine-track",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/icons-light.png",
        "backgroundColor": "#ffffff",
        "monochromeImage": "./assets/icons/icons-light.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "mediTrack.com",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "assets/icons/icons-light.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/icons-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/icons/icons-dark.png",
            "backgroundColor": "#121212"
          }
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/icons-light.png",
          "color": "#ffffff",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "notification": {
      "icon": "./assets/icons/icons-light.png",
      "color": "#ffffff",
      "androidMode": "default",
      "androidCollapsedTitle": "MediTrack"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf619588-b877-4172-94e9-3734760695ba"
      }
    }
  }
}